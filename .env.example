# --- Configuración de Ollama (LLM Local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0.2

# --- Base Vectorial Local (ChromaDB) ---
CHROMA_PERSIST_DIR=./chroma_data
COLLECTION_CVES=cve_knowledge_base
COLLECTION_CIS=hardening_cis_benchmarks
COLLECTION_POLICIES=internal_policies

# --- Parámetros de Ejecución ---
MAX_CONTEXT_TOKENS=8192
MAX_LLM_INTERPRETS=10
ENABLE_CRITIC_VALIDATION=true
DEBUG_MODE=true
