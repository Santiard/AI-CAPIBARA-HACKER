# =============================================================================
# AI-CAPIBARA-HACKER — Configuración de Entorno (.env.example)
# Copia este archivo como .env y ajusta los valores según tu entorno local.
# =============================================================================

# --- Servidor Ollama (LLM Local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0.2

# --- ChromaDB (Base Vectorial RAG) ---
CHROMA_PERSIST_DIR=chroma_data

# --- Colecciones de ChromaDB ---
COLLECTION_CVES=cve_knowledge_base
COLLECTION_CIS=hardening_cis_benchmarks
COLLECTION_POLICIES=internal_policies

# --- Parámetros de Ejecución ---
# Número máximo de vulnerabilidades interpretadas por el LLM por ejecución
MAX_LLM_INTERPRETS=10
# Tamaño máximo de la ventana de contexto del LLM (en tokens)
MAX_CONTEXT_TOKENS=8192

# --- Flags de Control ---
# Habilitar la validación del Agente Crítico (QA) antes del reporte
ENABLE_CRITIC_VALIDATION=true
# Activar modo de depuración con logs detallados
DEBUG_MODE=false
